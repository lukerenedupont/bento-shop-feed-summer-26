        "https://cdn.shopify.com/s/files/1/0275/2734/8310/files/0003_AURORA_HF5668-600_PHSRH000-2000_744fa566-df64-41cf-9073-9fb7908903e9.webp?v=1783549095&width=900",
        "https://cdn.shopify.com/s/files/1/0275/2734/8310/files/0003_AURORA_HF5668-600_PHSRH000-2000_3beab369-3b80-487a-96c3-6f92b4180273.webp?v=1783549168&width=900"

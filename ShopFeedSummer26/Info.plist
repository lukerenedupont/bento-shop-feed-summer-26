<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The dossier-lab feed API is a local Vite dev server over plain HTTP, and
	     its image/video URLs point back at the same origin. App Transport
	     Security blocks cleartext by default, so the feed and every generated
	     asset would silently fail to load. This exception is scoped to local
	     networking (localhost, *.local, link-local) and leaves ATS fully in
	     force for everything else, including server.shop.app.

	     GENERATE_INFOPLIST_FILE stays YES: Xcode merges its generated keys into
	     this file, so the target's other Info.plist settings are unaffected. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Required for a physical device to reach the Mac running the dev server. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Loads the prototype feed from the dossier-lab server running on your Mac.</string>
	<key>UIAppFonts</key>
	<array>
		<string>GTStandard-LHeavy.otf</string>
		<string>GTStandard-LSemibold.otf</string>
		<string>GTStandard-MBold.otf</string>
		<string>GTStandard-MMedium.otf</string>
		<string>GTStandard-MRegular.otf</string>
		<string>GTStandard-MSemibold.otf</string>
		<string>GoodSans-Bold.otf</string>
		<string>GoodSans-Medium.otf</string>
		<string>GoodSans-Regular.otf</string>
		<string>GoodSansText-Bold.otf</string>
		<string>GoodSansText-Medium.otf</string>
		<string>GoodSansText-Regular.otf</string>
		<string>Shopify Sans-Black Italic.otf</string>
		<string>Shopify Sans-Black.otf</string>
		<string>Shopify Sans-Bold Italic.otf</string>
		<string>Shopify Sans-Bold.otf</string>
		<string>Shopify Sans-Light Italic.otf</string>
		<string>Shopify Sans-Light.otf</string>
		<string>Shopify Sans-Medium Italic.otf</string>
		<string>Shopify Sans-Medium.otf</string>
		<string>Shopify Sans-Regular Italic.otf</string>
		<string>Shopify Sans-Regular.otf</string>
	</array>
</dict>
</plist>
